---
layout: layouts/base.njk
---

{# Language-aware URL prefix #}
{% set langPrefix = "/zh" if lang == "zh" else "" %}
{% set backText = "← 返回博客" if lang == "zh" else "← All posts" %}
{% set person = authors[author] %}

{# JSON-LD Article Schema for Blog Posts #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description | default(title) }}",
  "url": "{{ site.url }}{{ page.url }}",
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ date | isoDate }}",
  "author": {
    "@type": "Person",
    "name": "{{ author | default('Christian Findlay') }}"{% if person %},
    "url": "{{ person.url }}"{% endif %}
  },
  "publisher": {
    "@type": "Organization",
    "name": "too_many_cooks",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/images/og-image.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "image": "{{ site.url }}{{ cover | default('/assets/images/og-image.png') }}",
  "inLanguage": "{{ lang | default('en') }}"
  {% if tags %},
  "keywords": "{{ tags | join(', ') }}"
  {% endif %}
  {% if category %},
  "articleSection": "{{ category }}"
  {% endif %}
}
</script>

<div class="read-progress" aria-hidden="true"></div>

<article class="blog-post" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="container">
    <header class="blog-post-header reveal">
      <a href="{{ langPrefix }}/blog/" class="back-link">{{ backText }}</a>
      {% if category %}<a href="{{ langPrefix }}/blog/categories/{{ category | slugify }}/" class="chip">{{ category }}</a>{% endif %}
      <h1 itemprop="headline">{{ title }}</h1>
      {% if description %}<p class="blog-post-lede">{{ description }}</p>{% endif %}
      {% set bylinePost = null %}
      {% include "partials/post-byline.njk" %}
    </header>

    {% set coverPost = { data: { cover: cover, category: category } } %}
    <div class="blog-post-cover reveal">{% include "partials/post-cover.njk" %}</div>

    <div class="blog-post-content" itemprop="articleBody">
      {{ content | safe }}
    </div>

    <footer class="blog-post-footer">
      {% if person %}
      <div class="author-card">
        <span class="byline-avatar byline-avatar-large" aria-hidden="true">{{ person.initials }}</span>
        <div>
          <p class="author-card-name"><a href="{{ person.url }}" rel="author">{{ author }}</a></p>
          <p class="author-card-role">{{ person.role }}</p>
        </div>
      </div>
      {% endif %}
      <div class="cta-band">
        <p>Run your agents on one codebase without the collisions.</p>
        <div class="cta-band-buttons">
          <a href="{{ site.marketplace }}" class="btn btn-primary">Install for VS Code</a>
          <a href="{{ langPrefix }}/docs/getting-started/" class="btn btn-secondary">Get started</a>
        </div>
      </div>
      <a href="{{ langPrefix }}/blog/" class="back-link">{{ backText }}</a>
    </footer>
  </div>
</article>
