{
  "name": "too-many-cooks",
  "version": "0.5.0",
  "description": "Too Many Cooks MCP server — SQLite (local) or encrypted cloud backend",
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": {
    "too-many-cooks": "build/bin/server.js"
  },
  "files": [
    "build",
    "schema",
    "dataprovider",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimblesite/too-many-cooks",
    "directory": "too-many-cooks/packages/too-many-cooks"
  },
  "scripts": {
    "prebuild": "node ../../../scripts/fetch-dataprovider.mjs",
    "build": "tsc",
    "start": "node build/bin/server.js",
    "pretest": "node ../../../scripts/fetch-dataprovider.mjs",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../../bail-reporter.mjs --test-reporter-destination=stderr test/*.ts",
    "pretest:coverage": "node ../../../scripts/fetch-dataprovider.mjs",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov --reporter=json-summary --reports-dir=coverage --src=src node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../../bail-reporter.mjs --test-reporter-destination=stderr test/*.ts"
  },
  "dependencies": {
    "@nimblesite/shipwright-mcp": "^0.11.0",
    "better-sqlite3": "^13.0.3",
    "too-many-cooks-core": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
