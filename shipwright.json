{
  "manifestVersion": 1,
  "product": {
    "id": "too-many-cooks",
    "displayName": "Too Many Cooks",
    "version": "0.0.0-dev",
    "repository": "https://github.com/Nimblesite/too-many-cooks",
    "homepage": "https://tmc-mcp.dev"
  },
  "components": [
    {
      "id": "too-many-cooks-server",
      "kind": "mcp",
      "language": "typescript",
      "binaryName": "too-many-cooks",
      "expectedVersion": "${PRODUCT_VERSION}",
      "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "win32-x64"],
      "sources": ["npm-global"],
      "npm": { "package": "too-many-cooks", "bin": "too-many-cooks" },
      "verifyStartup": true,
      "versionCheckStrategy": "version-flag",
      "required": true
    },
    {
      "id": "too-many-cooks-vscode",
      "kind": "extension-vscode",
      "language": "typescript",
      "platforms": ["all"]
    }
  ],
  "supplyChain": {
    "slsaBuildLevel": 2,
    "provenance": true,
    "sbom": "cyclonedx",
    "signedChecksums": true,
    "frozenInstall": true,
    "pinnedActions": true,
    "oidcPublish": true,
    "vulnGate": "high"
  }
}
